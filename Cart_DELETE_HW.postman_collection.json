      "description": "ID активного товару для видалення (200 OK)"
    },
    {
      "key": "ciid_wrong",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string",
      "description": "ID неіснуючого у БД товару (для 404 Not Found)"
    },
    {
      "key": "ciid_other",
      "value": "77777777-7777-7777-7777-777777777777",
