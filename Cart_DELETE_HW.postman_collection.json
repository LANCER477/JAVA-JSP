    },
    {
      "key": "ciid_no_cart",
      "value": "99999999-9999-9999-9999-999999999999",
      "type": "string",
      "description": "ID товару користувача без відкритого кошика (для 422 Unprocessable Content)"
    }
  ],
  "item": [
    {
      "name": "1. DELETE Cart Item - Not Found in DB (404 Not Found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Response indicates cart item not found', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status.code).to.eql(404);",
              "    pm.expect(jsonData.data).to.include('Cart item not found');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user6}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host}}/cart?ciid={{ciid_wrong}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "cart"
          ],
          "query": [
            {
              "key": "ciid",
              "value": "{{ciid_wrong}}",
              "description": "ID неіснуючого товару"
            }
          ]
        },
        "description": "Перевірка 1: Переконатись, що CartItem взагалі існує у БД (повертає 404 Not Found)"
      },
      "response": []
    },
    {
      "name": "2. DELETE Cart Item - Belongs to Another User (403 Forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test('Response indicates item belongs to another entity/user', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status.code).to.eql(403);",
              "    pm.expect(jsonData.data).to.include('belongs to another entity');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user6}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host}}/cart?ciid={{ciid_other}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "cart"
          ],
          "query": [
            {
              "key": "ciid",
              "value": "{{ciid_other}}",
              "description": "ID товару чужого користувача"
            }
          ]
        },
        "description": "Перевірка 2: Переконатись, що даний CartItem належить авторизованому користувачеві (повертає 403 Forbidden)"
      },
      "response": []
    },
    {
      "name": "3. DELETE Cart Item - User Has No Open Cart (422 Unprocessable Content)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422 Unprocessable Content', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test('Response indicates user has no open cart', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status.code).to.eql(422);",
              "    pm.expect(jsonData.data).to.include('no open cart');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_no_cart}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host}}/cart?ciid={{ciid_no_cart}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "cart"
          ],
          "query": [
            {
              "key": "ciid",
              "value": "{{ciid_no_cart}}",
              "description": "Товар користувача без відкритого кошика"
            }
          ]
        },
        "description": "Перевірка 3: Переконатись, що користувач має відкритий кошик (повертає 422 Unprocessable Content)"
      },
      "response": []
    },
    {
      "name": "4. DELETE Cart Item - Belongs to Closed Cart (409 Conflict)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Response indicates item belongs to closed cart', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status.code).to.eql(409);",
              "    pm.expect(jsonData.data).to.include('closed cart');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user6}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host}}/cart?ciid={{ciid_closed}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "cart"
          ],
          "query": [
            {
              "key": "ciid",
              "value": "{{ciid_closed}}",
              "description": "Товар із закритого кошика того ж користувача"
            }
          ]
        },
        "description": "Перевірка 4: Переконатись, що він належить до активного (відкритого) кошику (повертає 409 Conflict)"
      },
      "response": []
    },
    {
      "name": "5. DELETE Cart Item - Success (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Cart item removed and updated cart returned', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status.code).to.eql(200);",
              "    pm.expect(jsonData.data).to.have.property('cartItems');",
              "    pm.expect(jsonData.data).to.have.property('price');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user6}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host}}/cart?ciid={{ciid}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "cart"
          ],
          "query": [
            {
              "key": "ciid",
              "value": "{{ciid}}",
              "description": "ID активного товару у відкритому кошику"
            }
          ]
        },
        "description": "Успішне проходження усіх 4 перевірок: видалення товару з активного кошика (повертає 200 OK)"
      },
      "response": []
    }
  ]
