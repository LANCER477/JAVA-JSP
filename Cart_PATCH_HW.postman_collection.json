  "item": [
    {
      "name": "0. GET Active Cart (Отримати ciid активного кошика)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Cart has items and sets ciid variable if present', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status.code).to.eql(200);",
              "    if (jsonData.data && jsonData.data.cartItems && jsonData.data.cartItems.length > 0) {",
              "        var firstId = jsonData.data.cartItems[0].id;",
              "        pm.collectionVariables.set('ciid', firstId);",
              "        if (pm.environment) {",
              "            pm.environment.set('ciid', firstId);",
              "        }",
              "        console.log('Centralized ciid updated to: ' + firstId);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user6}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{host}}/cart",
          "host": [
            "{{host}}"
          ],
          "path": [
            "cart"
          ]
        },
        "description": "Отримання активного кошика та автоматичне оновлення змінної {{ciid}} першим знайденим товаром"
      },
      "response": []
